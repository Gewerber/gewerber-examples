# Copy to `.env` next to docker-compose.yml and fill in the secrets.
# Generate secrets once with:  openssl rand -base64 32

# --- Image ------------------------------------------------------------------
# Prebuilt open-source image pushed to GHCR by CI.
IMAGE=ghcr.io/gewerber/gewerber-backend-core:prod-latest

# Container name (must be unique if you run several stacks on one host).
CONTAINER_NAME=gewerber-backend

# Serverpod run mode: production | staging.
RUNMODE=production

# Host port the API server is published on (container port is always 8080).
SERVER_PORT=8080

# --- Secrets (generate your own, never reuse these placeholders) ------------
# PostgreSQL password (POSTGRES_PASSWORD).
DB_PASSWORD=change-me-generate-with-openssl-rand-base64-32

# Redis password (--requirepass). Only used if you keep the redis service.
REDIS_PASSWORD=change-me-generate-with-openssl-rand-base64-32
